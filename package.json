{
  "name": "dsh-lan-gateway",
  "version": "1.0.0",
  "description": "DSH 局域网网关插件：DSH 本体保持本机回环地址不变，插件另开一个对局域网开放的端口把请求反向转发给本体，让手机、平板等设备（虚拟局域网或家庭局域网均可）访问同一个 DSH 界面。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "gateway",
    "lan"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "client": {
      "platform": "web",
      "inject": ["@deepseek-ai/dsh-client-ui-settings"]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "author": "KylinCloud-sys",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KylinCloud-sys/dsh-lan-gateway.git"
  },
  "homepage": "https://github.com/KylinCloud-sys/dsh-lan-gateway#readme",
  "bugs": {
    "url": "https://github.com/KylinCloud-sys/dsh-lan-gateway/issues"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*"
  }
}
